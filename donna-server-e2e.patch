+    if (/UPDATE subscriptions SET status=/.test(sql)) state.sub.status = p[1];
+    return { rows: [], rowCount: 1 };
+  };
+  const db = {
+    one,
+    async q(sql, p) { return query(sql, p); },
+    async tx(fn) { return fn({ query }); },
+    async withNamedLock(_name, fn) { return fn(); }
+  };
+  const toss = {
+    async issueBillingKey() {
+      // 다른 탭이 더 최신 결제창을 연 상황을 외부 API 왕복 중간에 재현한다.
+      state.session.status = "superseded";
+      return { billingKey: "bk-new", card: { company: "신한", number: "************1234" } };
+    },
+    async charge() {
+      chargeCalls += 1;
+      return { status: "DONE", orderId: "unexpected", totalAmount: 6000, paymentKey: "unexpected" };
+    },
+    async deleteBillingKey() {}
+  };
+
+  const service = serviceWith(db, toss);
+  await service.completeBilling({ sid: state.session.id, customerKey: "cust_key", authKey: "auth-old" }).catch(() => {});
+  assert.equal(chargeCalls, 0, "새 결제창에 밀린 callback은 카드 승인을 절대 호출하면 안 된다");
+});
+
+test("payment DONE 뒤 session 완료 전 중단돼도 successUrl 재호출은 다음 회차를 청구하지 않는다", async () => {
+  const done = {
+    id: "payment-1", subscription_id: "sub-1", order_id: "sub_sub1_1_1", payment_key: "pay-1",
