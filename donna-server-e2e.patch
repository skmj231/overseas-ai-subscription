@@ -0,0 +1,176 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { makeMailer } from "../src/mail.js";
+import { makeService } from "../src/service.js";
+
+const serviceSource = readFileSync(fileURLToPath(new URL("../src/service.js", import.meta.url)), "utf8");
+const NOW = new Date("2026-11-29T12:00:00.000Z");
+const ENV = {
+  SITE_URL: "https://donna.co.kr",
+  API_URL: "https://api.donna.co.kr",
+  PAYMENTS_ENABLED: "true",
+  TOSS_CLIENT_KEY: "test_ck"
+};
+
+function deps({ db, toss = {}, outbox, now = () => NOW }) {
+  let direct = 0;
+  const mail = makeMailer({
+    MAIL_API_KEY: "re_test",
+    async fetchImpl() { direct += 1; return new Response(JSON.stringify({ id: "mail-direct" }), { status: 200 }); }
+  });
+  const crypto = {
+    sign: (payload) => `signed-${payload.scope || "scope"}-${payload.jti || payload.sub || "token"}`,
+    verify: () => null,
+    encrypt: (value) => `enc:${value}`,
+    decrypt: (value) => String(value).replace(/^enc:/, "")
+  };
+  const service = makeService({ db, toss, mail, outbox, crypto, env: ENV, now, log: { info() {}, error() {} } });
+  return { service, direct: () => direct };
+}
+
+test("모든 결제·계정 메일 종류가 서비스 outbox 경로를 사용한다", () => {
+  for (const kind of ["receipt", "failed", "reminder", "canceled", "refunded", "cardChanged", "checkoutVerify", "resumeConfirm", "restore"]) {
+    assert.match(serviceSource, new RegExp(`queueMail\\(\\"${kind}\\"`), `${kind} 메일도 durable queue를 거쳐야 한다`);
+  }
+  assert.doesNotMatch(serviceSource, /await\s+mail\.(?:receipt|failed|reminder|canceled|refunded|cardChanged|checkoutVerify|resumeConfirm|restore)\(/);
+});
+
+test("결제 이메일 확인은 렌더된 본문을 30분 만료 outbox에 넣고 HTTP 메일을 직접 기다리지 않는다", async () => {
+  const db = {};
+  const queued = [];
+  const outbox = { async enqueue(message, client) { queued.push({ message, client }); return { created: true }; } };
+  const { service, direct } = deps({ db, outbox });
+
+  const result = await service.requestCheckoutVerification("buyer@example.com", "a".repeat(26));
+
+  assert.equal(result.mail_queued, true);
+  assert.equal(direct(), 0);
+  assert.equal(queued.length, 1);
+  assert.equal(queued[0].client, db);
+  assert.match(queued[0].message.eventKey, /^checkout_verify:[0-9a-f]{32}$/);
+  assert.doesNotMatch(queued[0].message.eventKey, /signed|buyer|@/);
+  assert.match(queued[0].message.subject, /결제 이메일/);
+  assert.match(queued[0].message.text, /링크를 여는 것만으로 결제되지는/);
+  assert.equal(new Date(queued[0].message.expiresAt).getTime(), NOW.getTime() + 30 * 60 * 1000);
+});
+
+test("결제 DONE 상태와 영수증 outbox 행은 같은 transaction client로 기록된다", async () => {
+  const state = {
+    sub: { id: "sub-1", customer_id: "cust-1", status: "pending", cancel_at_period_end: false,
+      period_no: 0, current_period_end: null, billing_key_encrypted: "enc:billing", toss_customer_key: "cust-key" },
+    customer: { id: "cust-1", email: "buyer@example.com", name: null },
+    payments: []
+  };
+  const txClient = { async query(sql, params = []) {
+    if (/UPDATE payments SET status='done'/.test(sql)) state.payments[0].status = "done";
+    if (/UPDATE subscriptions SET status=/.test(sql)) state.sub.status = params[1];
+    return { rows: [], rowCount: 1 };
+  } };
+  const db = {
+    async one(sql, params = []) {
+      if (/FROM subscriptions WHERE id=/.test(sql)) return { ...state.sub };
+      if (/FROM customers WHERE id=/.test(sql)) return { ...state.customer };
+      if (/status='done'/.test(sql)) return null;
+      if (/status='processing'/.test(sql)) return state.payments.find((p) => p.status === "processing") || null;
+      if (/COALESCE\(max\(attempt_no\)/.test(sql)) return { n: 1 };
+      if (/INSERT INTO payments/.test(sql)) {
+        const row = { id: "pay-1", subscription_id: params[0], order_id: params[1], period_no: params[2],
+          attempt_no: params[3], amount: params[4], status: "processing" };
+        state.payments.push(row);
+        return row;
+      }
+      return null;
+    },
+    async q() { return { rows: [], rowCount: 1 }; },
+    async tx(fn) { return fn(txClient); },
+    async withNamedLock(_key, fn) { return fn(); }
+  };
+  const queued = [];
+  const outbox = { async enqueue(message, client) { queued.push({ message, client }); return { created: true }; } };
+  const toss = { async charge({ orderId, amount }) {
+    return { status: "DONE", orderId, totalAmount: amount, paymentKey: "pay-key", approvedAt: NOW.toISOString() };
+  } };
+  const { service, direct } = deps({ db, toss, outbox });
+
+  const result = await service.charge(state.sub, { reason: "first" });
+
+  assert.equal(result.ok, true);
+  assert.equal(state.payments[0].status, "done");
+  assert.equal(queued.length, 1);
+  assert.equal(queued[0].client, txClient);
+  assert.equal(queued[0].message.eventKey, `receipt:${state.payments[0].order_id}`);
+  assert.match(queued[0].message.subject, /결제가 완료/);
+  assert.equal(direct(), 0);
+});
+
+test("갱신 알림 audit와 outbox는 한 transaction에 묶여 audit만 남는 유실 창을 없앤다", async () => {
+  const sub = { id: "sub-1", customer_id: "cust-1", status: "active", cancel_at_period_end: false,
+    period_no: 1, current_period_end: "2026-12-06T00:00:00.000Z", billing_key_encrypted: "enc:billing" };
+  const txQueries = [];
+  const txClient = { async query(sql) {
+    txQueries.push(sql);
+    if (/INSERT INTO audit/.test(sql)) return { rows: [{ id: 7 }], rowCount: 1 };
+    return { rows: [], rowCount: 1 };
+  } };
+  const db = {
+    async q(sql) {
+      if (/SELECT DISTINCT s\.\*/.test(sql)) return { rows: [{ ...sub }] };
+      if (/SELECT cs\.\*/.test(sql)) return { rows: [] };
+      if (/SELECT action FROM audit/.test(sql)) return { rows: [] };
+      return { rows: [] };
+    },
+    async one(sql) {
+      if (/FROM subscriptions WHERE id=/.test(sql)) return { ...sub };
+      if (/FROM checkout_sessions/.test(sql) || /FROM payments/.test(sql)) return null;
+      if (/SELECT email FROM customers/.test(sql)) return { email: "buyer@example.com" };
+      return null;
+    },
+    async tx(fn) { return fn(txClient); },
+    async withNamedLock(_key, fn) { return fn(); }
+  };
+  const queued = [];
+  const outbox = { async enqueue(message, client) { queued.push({ message, client }); return { created: true }; } };
+  const { service, direct } = deps({ db, outbox });
+
+  const result = await service.tick();
+
+  assert.equal(result.reminded, 1);
+  assert.equal(queued.length, 1);
+  assert.equal(queued[0].client, txClient);
+  assert.equal(queued[0].message.eventKey, "reminder:sub-1:once:remind7:1");
+  assert.ok(txQueries.some((sql) => /INSERT INTO audit/.test(sql)));
+  assert.equal(direct(), 0);
+});
+
+test("구매 복원 요청·감사로그·24시간 링크 메일은 한 transaction에 기록된다", async () => {
+  const txQueries = [];
+  const txClient = { async query(sql) {
+    txQueries.push(sql);
+    if (/INSERT INTO restore_requests/.test(sql)) return { rows: [{ id: "restore-1" }], rowCount: 1 };
+    return { rows: [], rowCount: 1 };
+  } };
+  const db = {
+    async one(sql) {
+      if (/FROM customers WHERE email/.test(sql)) return { id: "cust-1", email: "buyer@example.com" };
+      if (/FROM subscriptions WHERE customer_id/.test(sql)) return { id: "sub-1", customer_id: "cust-1", status: "active" };
+      return null;
+    },
+    async tx(fn) { return fn(txClient); }
+  };
+  const queued = [];
+  const outbox = { async enqueue(message, client) { queued.push({ message, client }); return { created: true }; } };
+  const { service, direct } = deps({ db, outbox });
+
+  const result = await service.requestRestore("buyer@example.com", "a".repeat(26), "b".repeat(43));
+
+  assert.equal(result.mail_queued, true);
+  assert.equal(queued.length, 1);
+  assert.equal(queued[0].client, txClient);
+  assert.equal(queued[0].message.eventKey, "restore:restore-1");
+  assert.match(queued[0].message.text, /반드시 복원을 요청한 Chrome/);
+  assert.equal(new Date(queued[0].message.expiresAt).getTime(), NOW.getTime() + 24 * 60 * 60 * 1000);
+  assert.ok(txQueries.some((sql) => /INSERT INTO audit/.test(sql)));
+  assert.equal(direct(), 0);
+});
diff --git a/server/test/mail-outbox.test.js b/server/test/mail-outbox.test.js
new file mode 100644
index 0000000..f7e28dc
