+++ b/server/test/mail-outbox.test.js
@@ -0,0 +1,200 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { makeMailer, validateMailConfig, MailDeliveryError } from "../src/mail.js";
+import { makeMailOutbox, mailFailure, retryDelayMs } from "../src/mail-outbox.js";
+
+const migration = readFileSync(fileURLToPath(new URL("../sql/003_email_outbox.sql", import.meta.url)), "utf8");
+
+function response(body, status = 200) {
+  return new Response(JSON.stringify(body), { status, headers: { "Content-Type": "application/json" } });
+}
+
+test("운영에서는 신규 결제 중단 중에도 복원·해지 메일 키가 필수다", () => {
+  assert.throws(
+    () => validateMailConfig({ NODE_ENV: "production", PAYMENTS_ENABLED: "true", MAIL_API_KEY: "" }),
+    /MAIL_API_KEY/
+  );
+  assert.throws(() => validateMailConfig({ NODE_ENV: "production", PAYMENTS_ENABLED: "false" }), /MAIL_API_KEY/);
+  assert.deepEqual(validateMailConfig({ NODE_ENV: "development", PAYMENTS_ENABLED: "false" }), { deliveryEnabled: false });
+  assert.deepEqual(validateMailConfig({ NODE_ENV: "production", PAYMENTS_ENABLED: "true", MAIL_API_KEY: "re_live" }), { deliveryEnabled: true });
+});
+
+test("outbox 스키마는 멱등키·동결 본문·재시도·provider 결과·worker lock을 보존한다", () => {
+  for (const field of ["event_key", "payload", "state", "attempts", "next_attempt_at", "provider_id", "last_error", "locked_at", "locked_by"]) {
+    assert.match(migration, new RegExp(`\\b${field}\\b`));
+  }
+  assert.match(migration, /event_key\s+text NOT NULL UNIQUE/);
+  assert.match(migration, /email_outbox_immutable/);
+  assert.match(migration, /NEW\.payload IS DISTINCT FROM OLD\.payload/);
+});
+
+test("Resend 요청은 10~15초 timeout과 안정된 멱등키를 보낸다", async () => {
+  const calls = [];
+  const mailer = makeMailer({
+    MAIL_API_KEY: "re_test",
+    timeoutMs: 1,
+    signalFactory(ms) { return { timeoutMs: ms }; },
+    async fetchImpl(url, options) { calls.push({ url, options }); return response({ id: "mail_123" }); }
+  });
+  const out = await mailer.send("buyer@example.com", "결제 완료", "인증 링크 secret", { idempotencyKey: "receipt:pay_1" });
+  assert.equal(out.id, "mail_123");
+  assert.equal(calls[0].options.headers["Idempotency-Key"], "receipt:pay_1");
+  assert.equal(calls[0].options.signal.timeoutMs, 10_000);
+  assert.deepEqual(JSON.parse(calls[0].options.body).to, ["buyer@example.com"]);
+});
+
+test("Resend 오류 응답 본문과 개인정보를 오류 메시지에 노출하지 않는다", async () => {
+  const mailer = makeMailer({
+    MAIL_API_KEY: "re_test",
+    async fetchImpl() { return response({ name: "rate_limit_exceeded", message: "buyer@example.com secret-link" }, 429); }
+  });
+  await assert.rejects(
+    () => mailer.send("buyer@example.com", "제목", "secret-link", { idempotencyKey: "event-1" }),
+    (err) => {
+      assert.equal(err.status, 429);
+      assert.equal(err.code, "rate_limit_exceeded");
+      assert.equal(err.retryable, true);
+      assert.doesNotMatch(err.message, /buyer|secret-link/);
+      return true;
+    }
+  );
+});
+
+test("메일 키 없는 dry-run 로그에는 주소·본문·인증 링크를 남기지 않는다", async () => {
+  const seen = [];
+  const mailer = makeMailer({ MAIL_API_KEY: "", log: { info: (...args) => seen.push(args) } });
+  const out = await mailer.send("buyer@example.com", "제목", "https://donna.co.kr/?token=secret", { idempotencyKey: "restore:1" });
+  assert.equal(out.dry, true);
+  const logged = JSON.stringify(seen);
+  assert.doesNotMatch(logged, /buyer@example|token=secret|제목|restore:1/);
+  assert.match(logged, /event_ref/);
+});
+
+test("네트워크·429·5xx·timeout만 재시도하고 일반 4xx는 종료한다", () => {
+  assert.equal(mailFailure(new MailDeliveryError("x", { status: 429 })).retryable, true);
+  assert.equal(mailFailure(new MailDeliveryError("x", { status: 503 })).retryable, true);
+  assert.equal(mailFailure(new MailDeliveryError("x", { status: 400 })).retryable, false);
+  assert.equal(mailFailure(Object.assign(new Error("secret body"), { name: "TimeoutError" })).safe, "timeout");
+  assert.equal(retryDelayMs(1), 60_000);
+  assert.equal(retryDelayMs(20), 6 * 60 * 60 * 1000);
+});
+
+test("enqueue는 동일 event key·동일 payload만 멱등 처리한다", async () => {
+  let saved = null;
+  const db = { async q(sql, params) {
+    if (sql.includes("INSERT INTO email_outbox")) {
+      if (saved) return { rows: [] };
+      saved = { id: 1, event_key: params[0], payload: JSON.parse(params[1]), state: "pending", attempts: 0, expires_at: params[3] };
+      return { rows: [saved] };
+    }
+    if (sql.includes("FROM email_outbox WHERE event_key")) return { rows: saved ? [saved] : [] };
+    throw new Error("unexpected SQL");
+  } };
+  const outbox = makeMailOutbox({ db, mailer: { async send() {} }, now: () => new Date("2026-09-26T00:00:00Z") });
+  const first = await outbox.enqueue({ eventKey: "receipt:pay-1", to: "BUYER@example.com", subject: "영수증", text: "내용" });
+  assert.equal(first.created, true);
+  const again = await outbox.enqueue({ eventKey: "receipt:pay-1", to: "buyer@example.com", subject: "영수증", text: "내용" });
+  assert.equal(again.created, false);
+  await assert.rejects(
+    () => outbox.enqueue({ eventKey: "receipt:pay-1", to: "buyer@example.com", subject: "다른 제목", text: "내용" }),
+    (err) => err.code === "idempotency_payload_mismatch"
+  );
+});
+
+test("운영 cipher를 주입하면 수신자·본문·메일 action token을 DB에 평문 저장하지 않는다", async () => {
+  let saved = null;
+  const cipher = {
+    sealMailPayload(plain) { return "m1." + Buffer.from(plain).toString("base64url").split("").reverse().join(""); },
+    openMailPayload(value) { return Buffer.from(value.slice(3).split("").reverse().join(""), "base64url").toString(); },
+    digestMailPayload(value) { return `digest:${value.length}`; }
+  };
+  const db = { async q(sql, params) {
+    if (sql.includes("INSERT INTO email_outbox")) {
+      saved = { id: 1, event_key: params[0], payload: JSON.parse(params[1]), state: "pending", attempts: 0, expires_at: params[3] };
+      return { rows: [saved] };
+    }
+    return { rows: [] };
+  } };
+  const outbox = makeMailOutbox({ db, cipher, mailer: { async send() { return { id: "m" }; } } });
+  await outbox.enqueue({ eventKey: "manage:1", to: "buyer@example.com", subject: "확인", text: "#action_token=secret" });
+  const stored = JSON.stringify(saved.payload);
+  assert.match(stored, /m1\./);
+  assert.doesNotMatch(stored, /buyer@example|action_token|secret/);
+});
+
+test("claim은 FOR UPDATE SKIP LOCKED로 due·stale 작업을 원자적으로 가져온다", async () => {
+  let seen = null;
+  const db = { async q(sql, params) { seen = { sql, params }; return { rows: [{ id: 7, attempts: 1 }] }; } };
+  const outbox = makeMailOutbox({ db, mailer: { async send() {} }, workerId: "worker-a", now: () => new Date("2026-09-26T00:00:00Z") });
+  const rows = await outbox.claim(500);
+  assert.equal(rows.length, 1);
+  assert.match(seen.sql, /FOR UPDATE SKIP LOCKED/);
+  assert.match(seen.sql, /expires_at IS NULL OR expires_at > \$1/);
+  assert.match(seen.sql, /state='sending' AND locked_at < \$2/);
+  assert.match(seen.sql, /state='sending'/);
+  assert.equal(seen.params[2], 50, "과도한 batch를 제한한다");
+  assert.equal(seen.params[3], "worker-a");
+});
+
+test("만료된 인증 링크 메일은 뒤늦게 발송하지 않고 dead로 닫는다", async () => {
+  let seen = null;
+  const db = { async q(sql, params) { seen = { sql, params }; return { rows: [{ id: 3 }] }; } };
+  const outbox = makeMailOutbox({ db, mailer: { async send() {} }, now: () => new Date("2026-09-26T00:30:00Z") });
+  const count = await outbox.expireStale();
+  assert.equal(count, 1);
+  assert.match(seen.sql, /last_error='message_expired'/);
+  assert.match(seen.sql, /expires_at <= \$1/);
+  assert.match(seen.sql, /state='sending' AND locked_at < \$2/, "죽은 worker가 잡은 만료 메일도 다시 보내지 않는다");
+  assert.equal(seen.params.length, 2);
+});
+
+test("worker는 provider id가 확인된 경우만 sent 처리한다", async () => {
+  const updates = [];
+  const db = { async q(sql, params) {
+    updates.push({ sql, params });
+    return { rows: [{ id: 9, state: "sent", provider_id: params[0] }] };
+  } };
+  const calls = [];
+  const mailer = { async send(to, subject, text, options) {
+    calls.push({ to, subject, text, options });
+    return { id: "resend_9" };
+  } };
+  const logs = [];
+  const outbox = makeMailOutbox({ db, mailer, workerId: "worker-a", log: { info: (...x) => logs.push(x), error: (...x) => logs.push(x) } });
+  const result = await outbox.deliverClaimed({
+    id: 9, event_key: "receipt:pay-9", attempts: 1,
+    payload: { to: "buyer@example.com", subject: "영수증", text: "본문" }
+  });
+  assert.equal(result.sent, true);
+  assert.equal(calls[0].options.idempotencyKey, "receipt:pay-9");
+  assert.match(updates[0].sql, /state='sent'/);
+  assert.equal(updates[0].params[0], "resend_9");
+  assert.doesNotMatch(JSON.stringify(logs), /buyer@example|본문/);
+});
+
+test("429는 retry로 돌리고 확인되지 않은 dry-run은 sent가 아닌 dead로 끝낸다", async () => {
+  const states = [];
+  const db = { async q(sql, params) {
+    states.push(params[0]);
+    return { rows: [{ id: 1, state: params[0], attempts: 1, last_error: params[1] }] };
+  } };
+  const quiet = { info() {}, error() {} };
+  let outbox = makeMailOutbox({
+    db,
+    mailer: { async send() { throw new MailDeliveryError("provider included secret", { status: 429, code: "rate_limit", retryable: true }); } },
+    workerId: "w", now: () => new Date("2026-09-26T00:00:00Z"), log: quiet
+  });
+  let result = await outbox.deliverClaimed({ id: 1, event_key: "e1", attempts: 1, payload: { to: "a@b.co", subject: "s", text: "x" } });
+  assert.equal(result.retry, true);
+  assert.equal(states.at(-1), "retry");
+
+  outbox = makeMailOutbox({
+    db, mailer: { async send() { return { dry: true }; } }, workerId: "w",
+    now: () => new Date("2026-09-26T00:00:00Z"), log: quiet
+  });
+  result = await outbox.deliverClaimed({ id: 2, event_key: "e2", attempts: 1, payload: { to: "a@b.co", subject: "s", text: "x" } });
+  assert.equal(result.dead, true);
+  assert.equal(states.at(-1), "dead");
+});
diff --git a/server/test/manage-action-auth.test.js b/server/test/manage-action-auth.test.js
new file mode 100644
index 0000000..701870c
--- /dev/null
+++ b/server/test/manage-action-auth.test.js
@@ -0,0 +1,199 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { makeManageActionAuth } from "../src/manage-action-auth.js";
+
+const START = new Date("2026-09-26T00:00:00.000Z");
+
+function fakeDb() {
+  let seq = 1;
+  const state = {
+    sub: { id: "sub-1", customer_id: "cust-1", manage_auth_version: 1, manage_state_version: 1 },
+    sessions: [], actions: []
+  };
+
+  const same = (a, b) => Buffer.isBuffer(a) && Buffer.isBuffer(b) && a.equals(b);
+  const sessionJoined = (tokenHash) => {
+    const s = state.sessions.find(x => same(x.token_hash, tokenHash));
+    if (!s) return null;
+    return {
+      session_id: s.id, subscription_id: s.subscription_id,
+      session_auth_version: s.auth_version, session_expires_at: s.expires_at,
+      session_revoked_at: s.revoked_at, customer_id: state.sub.customer_id,
+      subscription_auth_version: state.sub.manage_auth_version,
+      subscription_state_version: state.sub.manage_state_version
+    };
+  };
+  const actionJoined = (actionHash, sessionHash) => {
+    const s = state.sessions.find(x => same(x.token_hash, sessionHash));
+    const a = state.actions.find(x => same(x.token_hash, actionHash) && s && x.management_session_id === s.id);
+    if (!a || !s) return null;
+    return {
+      action_id: a.id, action: a.action, target_key: a.target_key,
+      action_auth_version: a.auth_version, action_state_version: a.state_version,
+      action_expires_at: a.expires_at, action_used_at: a.used_at,
+      action_revoked_at: a.revoked_at, session_id: s.id,
+      subscription_id: s.subscription_id, session_auth_version: s.auth_version,
+      session_expires_at: s.expires_at, session_revoked_at: s.revoked_at,
+      customer_id: state.sub.customer_id,
+      subscription_auth_version: state.sub.manage_auth_version,
+      subscription_state_version: state.sub.manage_state_version
+    };
+  };
+
+  const query = async (sql, p = []) => {
+    if (/SELECT id, manage_auth_version FROM subscriptions/.test(sql)) return { rows: [state.sub] };
+    if (/INSERT INTO management_sessions/.test(sql)) {
+      const row = { id: `session-${seq++}`, subscription_id: p[0], token_hash: p[1], auth_version: p[2], expires_at: p[3], revoked_at: null };
+      state.sessions.push(row); return { rows: [{ id: row.id, expires_at: row.expires_at }], rowCount: 1 };
+    }
+    if (/FROM management_sessions ms[\s\S]*FOR UPDATE OF ms, s/.test(sql)) return { rows: [sessionJoined(p[0])].filter(Boolean) };
+    if (/UPDATE management_action_tokens[\s\S]*WHERE subscription_id=/.test(sql)) {
+      for (const a of state.actions) if (a.subscription_id === p[0] && !a.used_at && !a.revoked_at) a.revoked_at = START;
+      return { rows: [] };
+    }
+    if (/INSERT INTO management_action_tokens/.test(sql)) {
+      const row = { id: `action-${seq++}`, management_session_id: p[0], subscription_id: p[1], action: p[2], target_key: p[3], token_hash: p[4], auth_version: p[5], state_version: p[6], expires_at: p[7], used_at: null, revoked_at: null };
+      state.actions.push(row); return { rows: [{ id: row.id, expires_at: row.expires_at }], rowCount: 1 };
+    }
+    if (/FROM management_action_tokens a/.test(sql)) return { rows: [actionJoined(p[0], p[1])].filter(Boolean) };
+    if (/UPDATE management_action_tokens SET used_at/.test(sql)) {
+      const a = state.actions.find(x => x.id === p[0] && !x.used_at);
+      if (!a) return { rows: [], rowCount: 0 };
+      a.used_at = START; return { rows: [{ id: a.id }], rowCount: 1 };
+    }
+    if (/UPDATE subscriptions[\s\S]*manage_auth_version=manage_auth_version\+1/.test(sql)) {
+      if (p[0] !== state.sub.id) return { rows: [] };
+      state.sub.manage_auth_version += 1; state.sub.manage_state_version += 1;
+      return { rows: [{ manage_auth_version: state.sub.manage_auth_version, manage_state_version: state.sub.manage_state_version }] };
+    }
+    if (/UPDATE management_sessions SET revoked_at/.test(sql)) {
+      let count = 0;
+      for (const s of state.sessions) if (s.subscription_id === p[0] && !s.revoked_at) { s.revoked_at = START; count++; }
+      return { rows: [], rowCount: count };
+    }
+    throw new Error(`unhandled tx SQL: ${sql}`);
+  };
+
+  const db = {
+    async tx(fn) { return fn({ query }); },
+    async one(sql, p = []) {
+      if (/FROM management_sessions ms/.test(sql)) return sessionJoined(p[0]);
+      if (/UPDATE subscriptions[\s\S]*manage_state_version=manage_state_version\+1/.test(sql)) {
+        if (p[0] !== state.sub.id || Number(p[1]) !== state.sub.manage_state_version) return null;
+        state.sub.manage_state_version += 1;
+        return { manage_state_version: state.sub.manage_state_version };
+      }
+      throw new Error(`unhandled one SQL: ${sql}`);
+    },
+    async q(sql, p = []) {
+      if (/UPDATE management_sessions SET last_seen_at/.test(sql)) return { rows: [], rowCount: 1 };
+      if (/UPDATE management_sessions SET revoked_at/.test(sql)) {
+        const s = state.sessions.find(x => same(x.token_hash, p[0]) && !x.revoked_at);
+        if (s) s.revoked_at = START;
+        return { rows: [], rowCount: s ? 1 : 0 };
+      }
+      throw new Error(`unhandled q SQL: ${sql}`);
+    }
+  };
+  return { db, state };
+}
+
+function fixture() {
+  const f = fakeDb();
+  let clock = START.getTime();
+  let n = 0;
+  const entropy = (size) => Buffer.alloc(size, ++n);
+  return { ...f, auth: makeManageActionAuth({ db: f.db, now: () => new Date(clock), entropy }), advance(ms) { clock += ms; } };
+}
+
+test("관리 세션은 DB에 원문 없이 저장되고 읽기 인증만 한다", async () => {
+  const f = fixture();
+  const made = await f.auth.issueReadSession("sub-1");
+  assert.match(made.session_token, /^ms1\.[A-Za-z0-9_-]{43}$/);
+  assert.equal(Buffer.isBuffer(f.state.sessions[0].token_hash), true);
+  assert.equal(f.state.sessions[0].token_hash.toString("utf8").includes(made.session_token), false);
+  const read = await f.auth.authenticateRead(made.session_token);
+  assert.deepEqual({ sub: read.subscriptionId, customer: read.customerId, version: read.authVersion }, { sub: "sub-1", customer: "cust-1", version: 1 });
+});
+
