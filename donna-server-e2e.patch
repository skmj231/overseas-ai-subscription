diff --git a/server/sql/002_payment_safety.sql b/server/sql/002_payment_safety.sql
new file mode 100644
index 0000000..2d6f7c1
--- /dev/null
+++ b/server/sql/002_payment_safety.sql
@@ -0,0 +1,69 @@
+-- 1.7.0 결제 안전성 보강.
+-- 기존 운영 데이터에 중복 청구 가능한 구독이 있으면 조용히 하나를 고르지 않고
+-- 배포를 중단한다. 운영자가 토스 대시보드와 대조해 먼저 정리해야 한다.
+DO $$
+BEGIN
+  IF EXISTS (
+    SELECT customer_id
+      FROM subscriptions
+     WHERE status IN ('pending','active','canceled','past_due')
+     GROUP BY customer_id HAVING count(*) > 1
+  ) THEN
+    RAISE EXCEPTION 'payment safety migration blocked: duplicate billable subscriptions exist';
+  END IF;
+END $$;
+
+CREATE UNIQUE INDEX IF NOT EXISTS subscriptions_one_billable_per_customer
+  ON subscriptions(customer_id)
+  WHERE status IN ('pending','active','canceled','past_due');
+
+ALTER TABLE payments ADD COLUMN IF NOT EXISTS period_no int;
+ALTER TABLE payments ADD COLUMN IF NOT EXISTS attempt_no int NOT NULL DEFAULT 1;
+ALTER TABLE payments ADD COLUMN IF NOT EXISTS provider_status text;
+ALTER TABLE payments ADD COLUMN IF NOT EXISTS reconciled_at timestamptz;
+
+-- 1.6.x 주문번호는 ..._<periodNo> 형식이었다. 회차를 복원하지 않으면 배포 직후
+-- 이미 결제된 회차를 새 회차로 오인해 다시 승인할 수 있다.
+UPDATE payments
+   SET period_no = ((regexp_match(order_id, '_([0-9]+)$'))[1])::int,
+       attempt_no = COALESCE(attempt_no, 1)
+ WHERE period_no IS NULL AND order_id ~ '_[0-9]+$';
+
+DO $$
+BEGIN
+  IF EXISTS (
+    SELECT subscription_id, period_no
+      FROM payments
+     WHERE status='done' AND period_no IS NOT NULL
+     GROUP BY subscription_id, period_no HAVING count(*) > 1
+  ) THEN
+    RAISE EXCEPTION 'payment safety migration blocked: duplicate successful period payments exist';
+  END IF;
+END $$;
+
+CREATE UNIQUE INDEX IF NOT EXISTS payments_one_done_per_period
+  ON payments(subscription_id, period_no)
+  WHERE status = 'done' AND period_no IS NOT NULL;
+CREATE UNIQUE INDEX IF NOT EXISTS payments_payment_key_unique
+  ON payments(payment_key)
+  WHERE payment_key IS NOT NULL;
+
+ALTER TABLE checkout_sessions ADD COLUMN IF NOT EXISTS status text NOT NULL DEFAULT 'open';
+ALTER TABLE checkout_sessions ADD COLUMN IF NOT EXISTS billing_key_encrypted text;
+ALTER TABLE checkout_sessions ADD COLUMN IF NOT EXISTS card_summary text;
+ALTER TABLE checkout_sessions ADD COLUMN IF NOT EXISTS completed_at timestamptz;
+ALTER TABLE checkout_sessions ADD COLUMN IF NOT EXISTS last_error text;
+ALTER TABLE checkout_sessions ADD COLUMN IF NOT EXISTS result_order_id text;
+
+-- 이 마이그레이션 이전 세션은 다시 청구에 사용하지 않는다. 이미 callback이 처리된
+-- 세션은 완료, 나머지는 무효화하고 사용자가 새 결제창을 열도록 한다.
+UPDATE checkout_sessions
+   SET status = CASE WHEN used_at IS NOT NULL THEN 'completed' ELSE 'superseded' END
+ WHERE status = 'open' AND created_at < now();
+
+CREATE UNIQUE INDEX IF NOT EXISTS checkout_one_open_per_subscription
+  ON checkout_sessions(subscription_id)
+  WHERE status IN ('open','processing');
+
+ALTER TABLE installations ADD COLUMN IF NOT EXISTS revoked_at timestamptz;
+CREATE INDEX IF NOT EXISTS installations_revoked_idx ON installations(revoked_at) WHERE revoked_at IS NOT NULL;
diff --git a/server/sql/003_email_outbox.sql b/server/sql/003_email_outbox.sql
new file mode 100644
index 0000000..dc967f1
--- /dev/null
+++ b/server/sql/003_email_outbox.sql
@@ -0,0 +1,40 @@
+-- 결제·계정 메일을 업무 트랜잭션과 함께 기록하고, 별도 worker가 재시도한다.
+-- event_key와 payload는 최초 기록 뒤 바뀌지 않아 같은 사건을 다른 내용으로
+-- 재사용하거나 Resend 멱등키와 본문이 어긋나는 일을 막는다.
+CREATE TABLE IF NOT EXISTS email_outbox (
+  id               bigserial PRIMARY KEY,
+  event_key        text NOT NULL UNIQUE,
+  payload          jsonb NOT NULL,
+  state            text NOT NULL DEFAULT 'pending'
+                   CHECK (state IN ('pending','sending','retry','sent','dead')),
+  attempts         int NOT NULL DEFAULT 0 CHECK (attempts >= 0),
+  next_attempt_at  timestamptz NOT NULL DEFAULT now(),
+  expires_at       timestamptz,
+  provider_id      text,
+  last_error       text,
+  locked_at        timestamptz,
+  locked_by        text,
+  created_at       timestamptz NOT NULL DEFAULT now(),
+  updated_at       timestamptz NOT NULL DEFAULT now(),
+  sent_at          timestamptz
+);
+
+CREATE INDEX IF NOT EXISTS email_outbox_due_idx
+  ON email_outbox(next_attempt_at, id)
+  WHERE state IN ('pending','retry','sending');
+
+CREATE OR REPLACE FUNCTION donna_email_outbox_immutable()
+RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+  IF NEW.event_key IS DISTINCT FROM OLD.event_key OR NEW.payload IS DISTINCT FROM OLD.payload
+     OR NEW.expires_at IS DISTINCT FROM OLD.expires_at THEN
+    RAISE EXCEPTION 'email_outbox event_key, payload and expires_at are immutable';
+  END IF;
+  RETURN NEW;
+END;
+$$;
+
+DROP TRIGGER IF EXISTS email_outbox_immutable ON email_outbox;
+CREATE TRIGGER email_outbox_immutable
+  BEFORE UPDATE OF event_key, payload, expires_at ON email_outbox
+  FOR EACH ROW EXECUTE FUNCTION donna_email_outbox_immutable();
diff --git a/server/sql/003_restore_security.sql b/server/sql/003_restore_security.sql
new file mode 100644
index 0000000..99b21b8
--- /dev/null
+++ b/server/sql/003_restore_security.sql
@@ -0,0 +1,17 @@
+-- 구매 복원은 결제 이메일만 안다고 실행할 수 없고, 복원을 요청한 Chrome과
+-- 메일을 받은 사람이 함께 확인해야 한다. 서명 토큰만으로는 메일 보안 스캐너의
+-- GET 요청을 구분할 수 없으므로 요청별 nonce의 해시와 1회 사용 상태를 DB에 둔다.
+CREATE TABLE IF NOT EXISTS restore_requests (
+  id               uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  subscription_id  uuid NOT NULL REFERENCES subscriptions(id) ON DELETE CASCADE,
+  install_id       text NOT NULL,
+  browser_proof_hash text NOT NULL,
+  expires_at       timestamptz NOT NULL,
+  used_at          timestamptz,
+  created_at       timestamptz NOT NULL DEFAULT now(),
+  CONSTRAINT restore_requests_proof_hash CHECK (browser_proof_hash ~ '^[0-9a-f]{64}$')
+);
+
+CREATE INDEX IF NOT EXISTS restore_requests_expiry_idx
+  ON restore_requests(expires_at)
+  WHERE used_at IS NULL;
diff --git a/server/sql/010_management_action_auth.sql b/server/sql/010_management_action_auth.sql
new file mode 100644
index 0000000..7828435
--- /dev/null
+++ b/server/sql/010_management_action_auth.sql
@@ -0,0 +1,78 @@
+-- Donna Plus management authorization hardening.
+--
+-- A management session may read subscription data and request a step-up email.
+-- It must never authorize a billing or entitlement mutation by itself.  Every
+-- sensitive mutation consumes a short-lived, single-use action token.
+
+ALTER TABLE subscriptions
+  ADD COLUMN IF NOT EXISTS manage_auth_version bigint NOT NULL DEFAULT 1;
+
+ALTER TABLE subscriptions
+  ADD COLUMN IF NOT EXISTS manage_state_version bigint NOT NULL DEFAULT 1;
+
+DO $$
+BEGIN
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_constraint WHERE conname = 'subscriptions_manage_auth_version_positive'
+  ) THEN
+    ALTER TABLE subscriptions
+      ADD CONSTRAINT subscriptions_manage_auth_version_positive
+      CHECK (manage_auth_version > 0);
+  END IF;
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_constraint WHERE conname = 'subscriptions_manage_state_version_positive'
+  ) THEN
+    ALTER TABLE subscriptions
+      ADD CONSTRAINT subscriptions_manage_state_version_positive
+      CHECK (manage_state_version > 0);
+  END IF;
+END $$;
+
+CREATE TABLE IF NOT EXISTS management_sessions (
+  id               uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  subscription_id  uuid NOT NULL REFERENCES subscriptions(id) ON DELETE CASCADE,
+  -- SHA-256 of the opaque token. Raw bearer values are never stored.
+  token_hash       bytea NOT NULL UNIQUE,
+  auth_version     bigint NOT NULL,
+  expires_at       timestamptz NOT NULL,
+  last_seen_at     timestamptz,
+  revoked_at       timestamptz,
+  created_at       timestamptz NOT NULL DEFAULT now(),
+  CONSTRAINT management_sessions_token_hash_length CHECK (octet_length(token_hash) = 32)
+);
+
+CREATE INDEX IF NOT EXISTS management_sessions_subscription_idx
+  ON management_sessions(subscription_id, created_at DESC);
+CREATE INDEX IF NOT EXISTS management_sessions_unrevoked_idx
+  ON management_sessions(subscription_id, expires_at)
+  WHERE revoked_at IS NULL;
+
+CREATE TABLE IF NOT EXISTS management_action_tokens (
+  id                     uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  management_session_id  uuid NOT NULL REFERENCES management_sessions(id) ON DELETE CASCADE,
+  subscription_id        uuid NOT NULL REFERENCES subscriptions(id) ON DELETE CASCADE,
+  action                 text NOT NULL,
+  -- Resource binding prevents an unlink token for device A from unlinking B.
+  target_key             text,
+  token_hash             bytea NOT NULL UNIQUE,
+  auth_version           bigint NOT NULL,
+  state_version          bigint NOT NULL,
+  expires_at             timestamptz NOT NULL,
+  used_at                timestamptz,
+  revoked_at             timestamptz,
+  created_at             timestamptz NOT NULL DEFAULT now(),
+  CONSTRAINT management_action_tokens_token_hash_length CHECK (octet_length(token_hash) = 32),
+  CONSTRAINT management_action_tokens_known_action CHECK (action IN (
+    'cancel_subscription',
+    'resume_subscription',
+    'refund_payment',
+    'change_card',
+    'unlink_install'
+  ))
+);
+
+CREATE INDEX IF NOT EXISTS management_action_tokens_session_idx
+  ON management_action_tokens(management_session_id, created_at DESC);
+CREATE INDEX IF NOT EXISTS management_action_tokens_open_idx
+  ON management_action_tokens(subscription_id, action, target_key, expires_at)
+  WHERE used_at IS NULL AND revoked_at IS NULL;
diff --git a/server/sql/011_checkout_link_recovery.sql b/server/sql/011_checkout_link_recovery.sql
new file mode 100644
index 0000000..c3d4da6
--- /dev/null
+++ b/server/sql/011_checkout_link_recovery.sql
@@ -0,0 +1,22 @@
+-- 결제 완료 저장과 Chrome 설치 연결 사이의 프로세스 중단을 복구한다.
+-- 기존에 적용된 마이그레이션 파일은 변경해도 재실행되지 않으므로 별도 파일로 둔다.
+ALTER TABLE checkout_sessions ADD COLUMN IF NOT EXISTS installation_linked_at timestamptz;
+
+-- 이미 실제 설치가 고객에게 연결된 과거 completed 세션은 완료 표시를 채운다.
+-- completed지만 연결이 빠진 세션은 NULL로 남겨 스케줄러가 승인 없이 연결만 복구한다.
+UPDATE checkout_sessions cs
+   SET installation_linked_at = COALESCE(cs.completed_at, now())
+  FROM subscriptions s, installations i
+ WHERE cs.subscription_id=s.id
+   AND cs.install_id IS NOT NULL
+   AND cs.status='completed'
+   AND i.public_install_id=cs.install_id
+   AND i.customer_id=s.customer_id
+   AND cs.installation_linked_at IS NULL;
+
+CREATE INDEX IF NOT EXISTS checkout_install_link_pending_idx
+  ON checkout_sessions(subscription_id, created_at)
+  WHERE install_id IS NOT NULL
+    AND result_order_id IS NOT NULL
+    AND installation_linked_at IS NULL
+    AND status IN ('completed','link_pending');
diff --git a/server/sql/012_management_authorization.sql b/server/sql/012_management_authorization.sql
new file mode 100644
index 0000000..26509be
--- /dev/null
+++ b/server/sql/012_management_authorization.sql
@@ -0,0 +1,21 @@
+-- Sensitive management actions are email-confirmed.  Card replacement and an
+-- immediate retry are separate customer intentions; a callback may charge only
+-- when the exact checkout session recorded that consent.
+ALTER TABLE checkout_sessions
+  ADD COLUMN IF NOT EXISTS retry_charge_authorized boolean NOT NULL DEFAULT false;
+
+CREATE UNIQUE INDEX IF NOT EXISTS management_sessions_id_subscription_unique
+  ON management_sessions(id, subscription_id);
+
+DO $$
+BEGIN
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_constraint WHERE conname = 'management_action_session_subscription_fk'
+  ) THEN
+    ALTER TABLE management_action_tokens
+      ADD CONSTRAINT management_action_session_subscription_fk
+      FOREIGN KEY (management_session_id, subscription_id)
+      REFERENCES management_sessions(id, subscription_id)
+      ON DELETE CASCADE;
+  END IF;
+END $$;
