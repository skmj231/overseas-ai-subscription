{
  "manifest_version": 3,
  "name": "Donna 도나: 해외 AI·SaaS 구독 결제 전 알림",
  "version": "1.7.0",
  "description": "해외 AI·SaaS 구독이 결제되기 전에 원화 예상액과 해지 경로를 알려드립니다. 3개까지 무료, 4개부터 3개월마다 6,000원 자동결제.",
  "homepage_url": "https://donna.co.kr/",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://open.er-api.com/*",
    "https://api.donna.co.kr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Donna · 결제 전 알림",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://checkout.stripe.com/*",
        "https://buy.stripe.com/*",
        "https://invoice.stripe.com/*",
        "https://billing.stripe.com/*",
        "https://pay.stripe.com/*",
        "https://*.paddle.com/*",
        "https://*.lemonsqueezy.com/*",
        "https://*.onfastspring.com/*",
        "https://*.chargebee.com/*",
        "https://*.recurly.com/*",
        "https://*.braintreegateway.com/*",
        "https://*.paypal.com/*",
        "https://*.gumroad.com/*",
        "https://*.polar.sh/*",
        "https://*.creem.io/*",
        "https://*.2checkout.com/*",
        "https://*.adyen.com/*",
        "https://*.checkout.com/*",
        "https://*.tosspayments.com/*",
        "https://*.inicis.com/*",
        "https://*.kakaopay.com/*",
        "https://online-pay.kakao.com/*",
        "https://mpay.kakao.com/*",
        "https://pay.naver.com/*",
        "https://*.nicepay.co.kr/*",
        "https://*.danalpay.com/*",
        "https://*.teledit.com/*",
        "https://*.klarna.com/*",
        "https://*.squareup.com/*",
        "https://*.square.site/*",
        "https://*.square.link/*",
        "https://*.mollie.com/*",
        "https://*.razorpay.com/*",
        "https://*.xsolla.com/*",
        "https://checkout.shopify.com/*",
        "https://*.myshopify.com/*",
        "https://shop.app/*",
        "https://payments.amazon.com/*",
        "https://apay.amazon.com/*",
        "https://*.payments-amazon.com/*"
      ],
      "all_frames": true,
      "js": [
        "rules.js",
        "watch.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon48.png",
        "icon128.png",
        "fonts/PretendardVariable.woff2"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "minimum_chrome_version": "116"
}
