+test("첫 결제 processing이 provider CANCELED면 incomplete·세션 실패로 끝내고 빌링키를 폐기한다", async () => {
+  const state = {
+    payment: { id: "pay-1", subscription_id: "sub-1", order_id: "order-1", status: "processing", period_no: 1 },
+    sub: { id: "sub-1", customer_id: "cust-1", status: "pending", period_no: 0, cancel_at_period_end: false, billing_key_encrypted: "enc:bk-1" },
