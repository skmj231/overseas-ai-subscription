+function mailStub() {
+  return new Proxy({}, { get: () => async () => ({ ok: true }) });
+}
+
+function serviceWith(db, toss, overrides = {}) {
+  return makeService({
+    db,
+    toss,
+    mail: mailStub(),
+    crypto: {
+      encrypt: (v) => `enc:${v}`,
+      decrypt: (v) => String(v).replace(/^enc:/, ""),
+      sign: () => "signed-token",
+      verify: () => null,
+      ...overrides.crypto
+    },
+    env: {
+      SITE_URL: "https://donna.co.kr",
+      API_URL: "https://api.donna.co.kr",
+      TOSS_CLIENT_KEY: "test_ck",
+      PAYMENTS_ENABLED: "true",
+      ...overrides.env
+    },
+    log: { error() {}, info() {} },
+    now: overrides.now || (() => FIXED_NOW)
+  });
+}
+
+test("processing 결제창이 있을 때 새 checkout은 기존 창을 무효화하거나 새 창을 만들지 않는다", async () => {
+  const customer = { id: "cust-1", email: "buyer@example.com" };
+  const subscription = {
+    id: "sub-1", customer_id: customer.id, status: "pending", toss_customer_key: "cust_key",
+    billing_key_encrypted: null, period_no: 0
+  };
+  const checkout = { id: "sid-processing", subscription_id: subscription.id, status: "processing" };
+  let inserted = 0;
+  let superseded = 0;
+
+  const query = async (sql) => {
+    if (/SELECT id FROM customers/.test(sql)) return { rows: [{ id: customer.id }] };
+    if (/FROM installations/.test(sql)) return { rows: [] };
+    if (/FROM subscriptions/.test(sql)) return { rows: [{ ...subscription }] };
+    if (/FROM checkout_sessions/.test(sql)) return { rows: [{ ...checkout }] };
+    if (/UPDATE checkout_sessions SET status='superseded'/.test(sql)) {
+      superseded += 1;
+      checkout.status = "superseded";
+      return { rows: [] };
+    }
+    if (/INSERT INTO checkout_sessions/.test(sql)) {
+      inserted += 1;
+      return { rows: [{ id: "sid-new", subscription_id: subscription.id, status: "open" }] };
+    }
+    return { rows: [] };
+  };
+  const db = {
+    async one(sql) {
+      if (/INSERT INTO customers/.test(sql)) return { ...customer };
+      if (/FROM checkout_sessions/.test(sql)) return { ...checkout };
+      return null;
+    },
+    async q(sql) { return query(sql); },
+    async tx(fn) { return fn({ query }); },
+    async withNamedLock(_name, fn) { return fn(); }
+  };
+  const service = serviceWith(db, {}, {
+    crypto: { verify: () => ({ scope: "checkout_email", email: customer.email, install: "a".repeat(26) }) }
+  });
+
+  let result = null, failure = null;
+  try {
+    result = await service.createCheckout({
+      email: customer.email,
+      install_id: "a".repeat(26),
+      recurring_accepted: true,
+      terms_accepted: true,
+      consent_version: "2026-09-19",
+      verification_token: "verified"
+    });
+  } catch (error) {
+    failure = error;
+  }
+
+  assert.ok(
+    failure?.status === 409 || result?.pending === true || result?.checkout_in_progress === true || result?.already === true,
+    "처리 중 결제가 있음을 명확히 알려야 한다"
+  );
+  assert.equal(inserted, 0, "처리 중인 세션과 경쟁하는 새 결제창을 만들면 안 된다");
+  assert.equal(superseded, 0, "이미 승인 중인 세션을 새 탭이 무효화하면 안 된다");
+});
+
+test("billingKey 발급 중 세션이 superseded되면 오래된 callback은 승인하지 않는다", async () => {
+  const state = {
+    session: {
+      id: "sid-old", subscription_id: "sub-1", customer_id: "cust-1", status: "open",
+      purpose: "new", created_at: FIXED_NOW.toISOString(), install_id: "a".repeat(26),
+      return_url: "https://donna.co.kr/plus-done.html", cancel_url: "https://donna.co.kr/plus.html"
