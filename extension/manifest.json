{
  "manifest_version": 3,
  "name": "돈나가요 Donna: 해외 AI·SaaS 구독 결제 전 알림",
  "version": "1.3.2",
  "description": "해외 AI·SaaS 구독이 자동 결제되기 전에 미리 알려드립니다. 사업자는 결제창의 Tax ID 입력과 분기별 세무 자료 정리도 도움받을 수 있습니다.",
  "homepage_url": "https://donna.co.kr/",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://open.er-api.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "돈나가요 Donna · 구독 알림",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://checkout.stripe.com/*",
        "https://buy.stripe.com/*",
        "https://invoice.stripe.com/*",
        "https://billing.stripe.com/*",
        "https://pay.stripe.com/*",
        "https://*.paddle.com/*",
        "https://*.lemonsqueezy.com/*",
        "https://*.onfastspring.com/*",
        "https://*.chargebee.com/*",
        "https://*.recurly.com/*",
        "https://*.braintreegateway.com/*",
        "https://*.paypal.com/*",
        "https://*.gumroad.com/*",
        "https://*.polar.sh/*",
        "https://*.creem.io/*",
        "https://*.2checkout.com/*",
        "https://*.adyen.com/*",
        "https://*.checkout.com/*",
        "https://*.tosspayments.com/*",
        "https://*.inicis.com/*",
        "https://*.kakaopay.com/*",
        "https://online-pay.kakao.com/*",
        "https://mpay.kakao.com/*",
        "https://pay.naver.com/*",
        "https://*.nicepay.co.kr/*",
        "https://*.danalpay.com/*",
        "https://*.teledit.com/*",
        "https://*.klarna.com/*",
        "https://*.squareup.com/*",
        "https://*.square.site/*",
        "https://*.square.link/*",
        "https://*.mollie.com/*",
        "https://*.razorpay.com/*",
        "https://*.xsolla.com/*",
        "https://checkout.shopify.com/*",
        "https://*.myshopify.com/*",
        "https://shop.app/*",
        "https://payments.amazon.com/*",
        "https://apay.amazon.com/*",
        "https://*.payments-amazon.com/*"
      ],
      "all_frames": true,
      "js": [
        "rules.js",
        "watch.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon48.png", "icon128.png"],
      "matches": ["https://*/*"]
    }
  ]
}
