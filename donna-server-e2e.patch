+function cardCallbackHarness({ sameKey = false, canceledBeforeCallback = false } = {}) {
+  const oldKey = sameKey ? "bk-same" : "bk-old";
+  const issuedKey = sameKey ? "bk-same" : "bk-new";
+  const state = {
+    session: {
+      id: "sid-card", subscription_id: "sub-1", customer_id: "cust-1", purpose: "change_card",
+      status: "open", created_at: FIXED_NOW.toISOString(), return_url: "https://donna.co.kr/plus-manage.html?token=t",
+      cancel_url: "https://donna.co.kr/plus-manage.html?token=t", billing_key_encrypted: null
+    },
+    sub: {
+      id: "sub-1", customer_id: "cust-1", status: canceledBeforeCallback ? "canceled" : "active",
+      cancel_at_period_end: canceledBeforeCallback, toss_customer_key: "cust_key",
+      billing_key_encrypted: `enc:${oldKey}`, card_summary: "old card", period_no: 1,
+      current_period_end: "2026-12-26T00:00:00Z"
+    },
+    cust: { id: "cust-1", email: "buyer@example.com" }
+  };
+  const calls = { issue: 0, charge: 0, saveKey: 0, deleted: [] };
+  const query = async (sql, params = []) => {
+    if (/UPDATE checkout_sessions SET billing_key_encrypted=/.test(sql)) {
+      calls.saveKey += 1;
+      state.session.billing_key_encrypted = params[1];
+      state.session.card_summary = params[2];
+      return { rows: [{ id: state.session.id }], rowCount: 1 };
+    }
+    if (/UPDATE subscriptions SET billing_key_encrypted=/.test(sql)) {
+      calls.saveKey += 1;
+      state.sub.billing_key_encrypted = params[1];
+      state.sub.card_summary = params[2];
+      return { rows: [], rowCount: 1 };
+    }
+    if (/UPDATE checkout_sessions SET status='completed'/.test(sql)) state.session.status = "completed";
+    return { rows: [], rowCount: 1 };
+  };
+  const db = {
+    async one(sql) {
+      if (/SELECT subscription_id FROM checkout_sessions/.test(sql)) return { subscription_id: state.sub.id };
+      if (/SELECT \* FROM checkout_sessions/.test(sql)) return { ...state.session };
+      if (/SELECT \* FROM subscriptions WHERE id=/.test(sql)) return { ...state.sub };
+      if (/SELECT \* FROM customers WHERE id=/.test(sql)) return { ...state.cust };
+      if (/UPDATE checkout_sessions SET status='processing'/.test(sql)) {
+        if (state.session.status !== "open") return null;
+        state.session.status = "processing";
+        return { id: state.session.id };
+      }
+      return null;
+    },
+    async q(sql, params) { return query(sql, params); },
+    async tx(fn) { return fn({ query }); },
+    async withNamedLock(_name, fn) { return fn(); }
+  };
+  const toss = {
+    async issueBillingKey() {
+      calls.issue += 1;
+      return { billingKey: issuedKey, card: { company: "테스트", number: "************1234" } };
+    },
+    async charge() { calls.charge += 1; throw new Error("active 카드 변경은 즉시 승인하면 안 됨"); },
+    async deleteBillingKey({ billingKey }) { calls.deleted.push(billingKey); }
+  };
+  return { state, calls, service: serviceWith(db, toss) };
+}
