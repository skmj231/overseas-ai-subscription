+import test from "node:test";
+import assert from "node:assert/strict";
+import { makeService } from "../src/service.js";
+
+function paymentDb({ auditFails = false } = {}) {
+  const state = {
+    sub: { id: "sub-1", customer_id: "cust-1", status: "active", cancel_at_period_end: false, period_no: 0,
+      current_period_end: null, billing_key_encrypted: "enc", toss_customer_key: "cust_key", fail_count: 0 },
+    cust: { id: "cust-1", email: "buyer@example.com", name: null }, payments: []
+  };
+  const one = async (sql, p = []) => {
+    if (/FROM subscriptions WHERE id=/.test(sql)) return { ...state.sub };
+    if (/FROM customers WHERE id=/.test(sql)) return { ...state.cust };
+    if (/FROM payments WHERE subscription_id=.*period_no=.*status='done'/.test(sql)) return state.payments.find(x => x.period_no === p[1] && x.status === "done") || null;
+    if (/FROM payments WHERE subscription_id=.*period_no=.*status='processing'/.test(sql)) return [...state.payments].reverse().find(x => x.period_no === p[1] && x.status === "processing") || null;
+    if (/COALESCE\(max\(attempt_no\)/.test(sql)) {
+      const used = state.payments.filter(x => x.period_no === p[1]).map(x => x.attempt_no);
+      return { n: (used.length ? Math.max(...used) : 0) + 1 };
+    }
+    if (/INSERT INTO payments/.test(sql)) {
+      const row = { id: `p-${state.payments.length + 1}`, subscription_id: p[0], order_id: p[1], period_no: p[2], attempt_no: p[3], amount: p[4], status: "processing" };
+      state.payments.push(row); return row;
+    }
+    return null;
+  };
+  const q = async (sql, p = []) => {
+    if (/INSERT INTO audit/.test(sql) && auditFails) throw new Error("audit unavailable");
+    if (/UPDATE payments SET status='failed'/.test(sql)) {
+      const row = state.payments.find(x => x.order_id === p[0]); if (row) row.status = "failed";
+    }
+    return { rows: [] };
+  };
+  const tx = async (fn) => fn({ query: async (sql, p = []) => {
+    if (/UPDATE payments SET status='done'/.test(sql)) {
+      const row = state.payments.find(x => x.order_id === p[0]);
+      Object.assign(row, { status: "done", payment_key: p[1], approved_at: p[2], raw: p[4] });
+    }
+    if (/UPDATE subscriptions SET status=/.test(sql)) {
+      Object.assign(state.sub, { status: p[1], current_period_start: p[2], current_period_end: p[3], period_no: p[4], fail_count: 0 });
+    }
+    return { rows: [] };
+  } });
+  return { state, one, q, tx, withNamedLock: async (_key, fn) => fn() };
+}
+
+function deps(db, toss) {
+  return makeService({
+    db, toss,
+    mail: { async receipt() {}, async failed() {} },
+    crypto: { decrypt: () => "billing-key", encrypt: x => x, sign: () => "token", verify: () => null },
+    env: { SITE_URL: "https://donna.co.kr", API_URL: "https://api.donna.co.kr", PAYMENTS_ENABLED: "true" },
+    log: { error() {} }, now: () => new Date("2026-09-26T00:00:00Z")
+  });
+}
+
+test("토스 DONE 뒤 감사로그 실패가 결제 실패로 뒤집히지 않는다", async () => {
+  const db = paymentDb({ auditFails: true });
+  const toss = { async charge({ orderId, amount }) { return { status: "DONE", orderId, totalAmount: amount, paymentKey: "pay-1", approvedAt: "2026-09-26T00:00:00Z" }; } };
+  const result = await deps(db, toss).charge(db.state.sub, { reason: "first" });
+  assert.equal(result.ok, true);
+  assert.equal(db.state.payments[0].status, "done");
+  assert.equal(db.state.sub.status, "active");
+  assert.equal(db.state.sub.period_no, 1);
+});
+
+test("승인 응답 timeout 뒤 orderId 조회가 DONE이면 Plus를 복구한다", async () => {
+  const db = paymentDb();
+  let lookedUp = null;
+  const toss = {
+    async charge() { const e = new Error("timeout"); e.name = "TimeoutError"; throw e; },
+    async getPaymentByOrderId(orderId) { lookedUp = orderId; return { status: "DONE", orderId, totalAmount: 6000, paymentKey: "pay-recovered", approvedAt: "2026-09-26T00:00:00Z" }; }
+  };
+  const result = await deps(db, toss).charge(db.state.sub, { reason: "first" });
+  assert.equal(result.ok, true);
+  assert.equal(result.payment.paymentKey, "pay-recovered");
+  assert.equal(lookedUp, db.state.payments[0].order_id);
+  assert.equal(db.state.payments[0].status, "done");
+});
+
+test("승인 결과를 확인할 수 없으면 실패로 단정하지 않고 processing을 유지한다", async () => {
+  const db = paymentDb();
+  const toss = {
+    async charge() { const e = new Error("network lost"); e.name = "TimeoutError"; throw e; },
+    async getPaymentByOrderId() { const e = new Error("not found yet"); e.status = 404; throw e; }
+  };
+  const result = await deps(db, toss).charge(db.state.sub, { reason: "first" });
+  assert.equal(result.pending, true);
+  assert.equal(db.state.payments[0].status, "processing");
+  assert.match(result.reason, /다시 결제하지 마세요/);
+});
