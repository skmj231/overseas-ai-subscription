diff --git a/server/test/migrations.test.js b/server/test/migrations.test.js
new file mode 100644
index 0000000..8e15ae0
--- /dev/null
+++ b/server/test/migrations.test.js
@@ -0,0 +1,48 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { applyMigrationFiles } from "../src/db.js";
+
+function fakeClient() {
+  const applied = new Set();
+  const executed = [];
+  return {
+    applied,
+    executed,
+    async query(sql, params = []) {
+      executed.push([sql, params]);
+      if (/SELECT filename FROM schema_migrations/.test(sql)) {
+        return { rows: applied.has(params[0]) ? [{ filename: params[0] }] : [] };
+      }
+      if (/INSERT INTO schema_migrations/.test(sql)) applied.add(params[0]);
+      return { rows: [] };
+    }
+  };
+}
+
+test("마이그레이션 SQL은 서버를 다시 시작해도 파일당 한 번만 실행한다", async () => {
+  const client = fakeClient();
+  const files = [
+    { name: "001_init.sql", sql: "-- init-once" },
+    { name: "002_payment_safety.sql", sql: "-- payment-safety-once" }
+  ];
+
+  await applyMigrationFiles(client, files);
+  await applyMigrationFiles(client, files);
+
+  assert.equal(client.executed.filter(([sql]) => sql === "-- init-once").length, 1);
+  assert.equal(client.executed.filter(([sql]) => sql === "-- payment-safety-once").length, 1);
+  assert.deepEqual([...client.applied], ["001_init.sql", "002_payment_safety.sql"]);
+});
+
+test("마이그레이션 실패는 기록하지 않고 rollback해 다음 시작 때 재시도한다", async () => {
+  const client = fakeClient();
+  const original = client.query;
+  client.query = async (sql, params = []) => {
+    if (sql === "-- broken") throw new Error("migration failed");
+    return original.call(client, sql, params);
+  };
+
+  await assert.rejects(() => applyMigrationFiles(client, [{ name: "003_broken.sql", sql: "-- broken" }]), /migration failed/);
+  assert.equal(client.applied.has("003_broken.sql"), false);
+  assert.ok(client.executed.some(([sql]) => sql === "ROLLBACK"));
+});
