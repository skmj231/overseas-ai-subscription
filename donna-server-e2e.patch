index 0000000..30ea3e4
--- /dev/null
+++ b/server/test/restore-security.test.js
@@ -0,0 +1,154 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import fs from "node:fs";
+import vm from "node:vm";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { makeService } from "../src/service.js";
+
+const INSTALL = "z".repeat(26);
+const PROOF = "p".repeat(43);
+const JTI = "11111111-1111-4111-8111-111111111111";
+const NOW = new Date("2026-09-26T00:00:00.000Z");
+
+function fixture() {
+  let linked = false;
+  const request = {
+    id: JTI, subscription_id: "sub-1", install_id: INSTALL,
+    browser_proof_hash: createHash("sha256").update(PROOF).digest("hex"),
+    expires_at: new Date("2026-09-27T00:00:00.000Z"), used_at: null
+  };
+  const db = {
+    async withNamedLock(key, fn) { assert.equal(key, `restore:${JTI}`); return fn(); },
+    async one(sql) {
+      if (sql.includes("FROM restore_requests")) return request;
+      if (sql.includes("FROM subscriptions")) return { id: "sub-1", customer_id: "cust-1", status: "active" };
+      throw new Error("unexpected one: " + sql);
+    },
+    async q(sql) {
+      if (sql.includes("UPDATE restore_requests")) {
+        if (request.used_at) return { rows: [] };
+        request.used_at = NOW; return { rows: [{ id: JTI }] };
+      }
+      if (sql.includes("INSERT INTO audit")) return { rows: [] };
+      throw new Error("unexpected q: " + sql);
+    },
+    async tx(fn) {
+      return fn({ query: async (sql) => {
+        if (sql.includes("FROM customers")) return { rows: [{ id: "cust-1" }] };
+        if (sql.includes("FROM installations") && sql.includes("public_install_id")) return { rows: linked ? [{ id: "ins-1", customer_id: "cust-1", public_install_id: INSTALL }] : [] };
+        if (sql.includes("count(*)")) return { rows: [{ n: 0 }] };
+        if (sql.includes("INSERT INTO installations")) { linked = true; return { rows: [{ id: "ins-1", customer_id: "cust-1", public_install_id: INSTALL }] }; }
+        if (sql.includes("UPDATE installations SET last_seen_at")) return { rows: [] };
+        throw new Error("unexpected tx query: " + sql);
+      } });
+    }
+  };
+  const crypto = {
+    verify(token) {
+      return token === "valid-token" ? { scope: "restore_install", sub: "sub-1", install: INSTALL, jti: JTI } : null;
+    },
+    sign() { throw new Error("unused"); }
+  };
+  const service = makeService({
+    db, crypto, toss: {}, mail: {}, env: { SITE_URL: "https://donna.co.kr", API_URL: "https://api.donna.co.kr" },
+    now: () => NOW, log: { error() {} }
+  });
+  return { service, request, wasLinked: () => linked };
+}
+
+test("복원 POST는 요청 Chrome의 nonce가 일치할 때만 연결하고 DB에서 한 번만 소비한다", async () => {
+  const f = fixture();
+  await assert.rejects(
+    f.service.confirmRestore("valid-token", INSTALL, "x".repeat(43)),
+    e => e.status === 401 && e.code === "RESTORE_PROOF_MISMATCH"
+  );
+  assert.equal(f.request.used_at, null);
+  assert.equal(f.wasLinked(), false);
+
+  assert.deepEqual(await f.service.confirmRestore("valid-token", INSTALL, PROOF), { ok: true });
+  assert.equal(f.wasLinked(), true);
+  assert.ok(f.request.used_at);
+  await assert.rejects(
+    f.service.confirmRestore("valid-token", INSTALL, PROOF),
+    e => e.status === 401 && e.code === "RESTORE_PROOF_MISMATCH"
+  );
+});
+
+test("서명 토큰의 설치 대상과 POST 대상이 다르면 DB 조회 전 거절한다", async () => {
+  const f = fixture();
+  await assert.rejects(
+    f.service.confirmRestore("valid-token", "y".repeat(26), PROOF),
+    e => e.status === 401
+  );
+  assert.equal(f.request.used_at, null);
+  assert.equal(f.wasLinked(), false);
+});
+
+test("만료된 DB 복원 요청은 HMAC 토큰이 남아 있어도 사용할 수 없다", async () => {
+  const f = fixture();
+  f.request.expires_at = new Date("2026-09-25T23:59:59.000Z");
+  await assert.rejects(
+    f.service.confirmRestore("valid-token", INSTALL, PROOF),
+    e => e.status === 401 && e.code === "RESTORE_PROOF_MISMATCH"
+  );
+  assert.equal(f.wasLinked(), false);
+});
+
+test("복원 확인 화면은 fragment를 먼저 지우고 사용자 클릭 전에는 POST하지 않는다", async () => {
+  const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../..");
+  const source = fs.readFileSync(path.join(root, "plus-restore.js"), "utf8");
+  const encoded = Buffer.from(JSON.stringify({ scope: "restore_install", install: INSTALL })).toString("base64url");
+  const token = encoded + ".test-signature";
+  const elements = Object.fromEntries(["restore-confirm", "restore-title", "restore-lead", "restore-message"].map(id => [id, {
+    id, textContent: "", className: "", disabled: false, hidden: false,
+    addEventListener(type, fn) { if (type === "click") this.click = fn; }
+  }]));
+  const stored = new Map([["donna_restore_proof:" + INSTALL, JSON.stringify({ proof: PROOF, expires_at: Date.now() + 60_000 })]]);
+  let cleaned = "", fetches = 0, request = null;
+  vm.runInNewContext(source, {
+    document: { getElementById: id => elements[id] },
+    location: { hash: "#token=" + token, pathname: "/plus-restore.html", search: "" },
+    history: { replaceState(_a, _b, value) { cleaned = value; } },
+    localStorage: { getItem: key => stored.get(key) || null, removeItem: key => stored.delete(key) },
+    fetch: async (_url, options) => { fetches += 1; request = JSON.parse(options.body); return { ok: true, json: async () => ({ ok: true }) }; },
+    URLSearchParams, atob, decodeURIComponent, AbortController, setTimeout, clearTimeout, Date, JSON, Array, String, Error
+  });
+  assert.equal(cleaned, "/plus-restore.html", "메일 토큰을 주소에서 즉시 제거한다");
+  assert.equal(fetches, 0, "메일 스캐너나 단순 페이지 열기로 상태를 바꾸지 않는다");
+  await elements["restore-confirm"].click();
+  assert.equal(fetches, 1);
+  assert.deepEqual(request, { token, install_id: INSTALL, browser_proof: PROOF });
+  assert.equal(stored.has("donna_restore_proof:" + INSTALL), false, "성공한 nonce는 브라우저에서도 제거한다");
+});
+
+test("복원 POST 응답이 유실돼도 license가 Plus면 실패로 오해하지 않는다", async () => {
+  const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../..");
+  const source = fs.readFileSync(path.join(root, "plus-restore.js"), "utf8");
+  const token = Buffer.from(JSON.stringify({ scope: "restore_install", install: INSTALL })).toString("base64url") + ".sig";
+  const elements = Object.fromEntries(["restore-confirm", "restore-title", "restore-lead", "restore-message"].map(id => [id, {
+    textContent: "", className: "", disabled: false, hidden: false,
+    addEventListener(type, fn) { if (type === "click") this.click = fn; }
+  }]));
+  const key = "donna_restore_proof:" + INSTALL;
+  const stored = new Map([[key, JSON.stringify({ proof: PROOF, expires_at: Date.now() + 60_000 })]]);
+  let fetches = 0;
+  vm.runInNewContext(source, {
+    document: { getElementById: id => elements[id] },
+    location: { hash: "#token=" + token, pathname: "/plus-restore.html", search: "" },
+    history: { replaceState() {} },
+    localStorage: { getItem: k => stored.get(k) || null, removeItem: k => stored.delete(k) },
+    fetch: async (url) => {
+      fetches += 1;
+      if (url.includes("/restore/confirm")) throw new TypeError("response lost");
+      return { ok: true, json: async () => ({ tier: "plus" }) };
+    },
+    URLSearchParams, atob, decodeURIComponent, encodeURIComponent, AbortController, setTimeout, clearTimeout, Date, JSON, Array, String, Error, TypeError
+  });
+  await elements["restore-confirm"].click();
+  assert.equal(fetches, 2);
+  assert.equal(elements["restore-title"].textContent, "구매 복원이 완료됐습니다");
+  assert.equal(elements["restore-confirm"].hidden, true);
+  assert.equal(stored.has(key), false);
+});
