+import test from "node:test";
+import assert from "node:assert/strict";
+import { makeApp } from "../src/app.js";
+import { makeService } from "../src/service.js";
+
+const FIXED_NOW = new Date("2026-09-26T00:00:00Z");
+const ENV = {
+  SITE_URL: "https://donna.co.kr",
+  API_URL: "https://api.donna.co.kr",
+  TOSS_CLIENT_KEY: "test_ck",
+  PAYMENTS_ENABLED: "true"
+};
+
+function mailStub() {
+  return new Proxy({}, { get: () => async () => ({ ok: true }) });
+}
+
+function cryptoStub(verify = () => ({ scope: "manage", sub: "sub-1" })) {
+  return {
+    encrypt: (value) => `enc:${value}`,
+    decrypt: (value) => String(value).replace(/^enc:/, ""),
+    sign: () => "signed-token",
+    verify
+  };
+}
+
+function serviceWith(db, toss = {}, overrides = {}) {
+  return makeService({
+    db,
+    toss,
+    mail: overrides.mail || mailStub(),
+    crypto: overrides.crypto || cryptoStub(),
+    env: { ...ENV, ...overrides.env },
+    log: { error() {}, info() {} },
+    now: overrides.now || (() => FIXED_NOW)
+  });
+}
+
+function cancelHarness({ status, periodEnd, billingKey = "enc:bk-current" }) {
+  const state = {
+    sub: {
+      id: "sub-1", customer_id: "cust-1", status, current_period_end: periodEnd,
+      cancel_at_period_end: false, billing_key_encrypted: billingKey
+    },
+    cust: { id: "cust-1", email: "buyer@example.com" }
+  };
+  const deleted = [];
+  const db = {
+    async one(sql) {
+      if (/FROM subscriptions WHERE id=/.test(sql)) return { ...state.sub };
+      if (/FROM customers WHERE id=/.test(sql)) return { ...state.cust };
+      return null;
+    },
+    async q(sql, params = []) {
+      if (/UPDATE subscriptions SET cancel_at_period_end=true/.test(sql)) {
+        state.sub.cancel_at_period_end = true;
+        state.sub.status = params[1];
+      }
+      if (/UPDATE subscriptions SET billing_key_encrypted=NULL/.test(sql)) state.sub.billing_key_encrypted = null;
+      return { rows: [], rowCount: 1 };
+    },
+    async tx(fn) { return fn({ query: this.q.bind(this) }); },
+    async withNamedLock(_name, fn) { return fn(); }
+  };
+  const toss = { async deleteBillingKey({ billingKey: value }) { deleted.push(value); } };
+  return { state, deleted, service: serviceWith(db, toss) };
+}
+
+test("active인데 이용 종료일이 없으면 해지는 즉시 expired 처리하고 빌링키를 폐기한다", async () => {
+  const { state, deleted, service } = cancelHarness({ status: "active", periodEnd: null });
+
+  const result = await service.cancel("manage-token");
+
+  assert.equal(result.ok, true);
+  assert.equal(result.immediate, true);
+  assert.equal(state.sub.status, "expired");
+  assert.equal(state.sub.cancel_at_period_end, true);
+  assert.equal(state.sub.billing_key_encrypted, null);
+  assert.deepEqual(deleted, ["bk-current"]);
+});
+
+test("past_due이고 이용 종료일이 지났으면 해지는 즉시 expired 처리하고 빌링키를 폐기한다", async () => {
+  const { state, deleted, service } = cancelHarness({
+    status: "past_due",
+    periodEnd: "2026-09-25T23:59:59Z"
+  });
+
+  const result = await service.cancel("manage-token");
+
+  assert.equal(result.immediate, true);
+  assert.equal(state.sub.status, "expired");
+  assert.equal(state.sub.cancel_at_period_end, true);
+  assert.equal(state.sub.billing_key_encrypted, null);
+  assert.deepEqual(deleted, ["bk-current"]);
+});
+
+function refundHarness({ processing = null, latest = null }) {
+  const sub = {
+    id: "sub-1", customer_id: "cust-1", status: "active", cancel_at_period_end: false,
+    current_period_end: "2026-12-26T00:00:00Z", billing_key_encrypted: "enc:bk-current"
+  };
+  const customer = { id: "cust-1", email: "buyer@example.com" };
+  let cancelCalls = 0;
+  const db = {
+    async one(sql) {
+      if (/FROM subscriptions WHERE id=/.test(sql)) return { ...sub };
+      if (/FROM customers WHERE id=/.test(sql)) return { ...customer };
+      if (/status='processing'/.test(sql) && /FROM payments/.test(sql)) return processing && { ...processing };
+      if (/status IN \('done','canceled','partial_canceled'\)/.test(sql)) return latest && { ...latest };
+      return null;
+    },
+    async q() { return { rows: [], rowCount: 1 }; },
+    async tx(fn) { return fn({ query: this.q.bind(this) }); },
+    async withNamedLock(_name, fn) { return fn(); }
+  };
+  const toss = { async cancel() { cancelCalls += 1; return { status: "CANCELED", balanceAmount: 0 }; } };
+  return { service: serviceWith(db, toss), cancelCalls: () => cancelCalls };
+}
+
+test("가장 최근 결제가 partial_canceled면 자동 전액환불을 거부한다", async () => {
+  const latest = {
+    id: "pay-2", subscription_id: "sub-1", status: "partial_canceled", amount: 6000,
