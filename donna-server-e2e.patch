+    },
+    customer: { id: "cust-1", email: "buyer@example.com" },
+    payments: []
+  };
+  let chargeCalls = 0;
+
+  const one = async (sql, p = []) => {
+    if (/SELECT subscription_id FROM checkout_sessions/.test(sql)) return { subscription_id: state.session.subscription_id };
+    if (/SELECT \* FROM checkout_sessions/.test(sql)) return { ...state.session };
+    if (/SELECT \* FROM subscriptions WHERE id=/.test(sql)) return { ...state.sub };
+    if (/SELECT \* FROM customers WHERE id=/.test(sql)) return { ...state.customer };
+    if (/status='done'/.test(sql) && /FROM payments/.test(sql)) return null;
+    if (/status='processing'/.test(sql) && /FROM payments/.test(sql)) return state.payments.find((x) => x.status === "processing") || null;
+    if (/COALESCE\(max\(attempt_no\)/.test(sql)) return { n: 1 };
+    if (/INSERT INTO payments/.test(sql)) {
+      const row = { id: "pay-row", subscription_id: p[0], order_id: p[1], period_no: p[2], attempt_no: p[3], amount: p[4], status: "processing" };
+      state.payments.push(row);
+      return row;
+    }
+    return null;
+  };
+  const query = async (sql, p = []) => {
+    if (/UPDATE checkout_sessions SET status='processing'/.test(sql) && state.session.status === "open") state.session.status = "processing";
+    if (/UPDATE checkout_sessions SET billing_key_encrypted/.test(sql)) {
+      // 실제 PostgreSQL처럼 부모 구현이 status 조건을 추가하면 superseded 행은 갱신하지 않는다.
+      const guarded = /status\s*=\s*'processing'|status\s+IN/i.test(sql.split(/WHERE/i)[1] || "");
+      if (!guarded || state.session.status === "processing") {
+        state.session.billing_key_encrypted = p[1];
+        state.session.status = "processing";
+        return { rows: [], rowCount: 1 };
+      }
+      return { rows: [], rowCount: 0 };
+    }
+    if (/UPDATE subscriptions SET billing_key_encrypted/.test(sql)) state.sub.billing_key_encrypted = p[1];
+    if (/UPDATE payments SET status='done'/.test(sql)) {
+      const row = state.payments.find((x) => x.order_id === p[0]);
+      if (row) row.status = "done";
