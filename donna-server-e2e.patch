+  );
+  assert.equal(cancelCalls(), 0, "부분취소된 승인에 자동 전액취소를 다시 보내면 안 된다");
+});
+
+test("processing 승인 결과가 남아 있으면 이전 결제 환불을 시작하지 않는다", async () => {
+  const processing = { id: "pay-processing", status: "processing" };
+  const latest = {
+    id: "pay-1", subscription_id: "sub-1", status: "done", amount: 6000,
+    approved_at: "2026-09-25T00:00:00Z", payment_key: "pay-key-1"
+  };
+  const { service, cancelCalls } = refundHarness({ processing, latest });
+
+  await assert.rejects(
+    service.refund("manage-token"),
+    (error) => error.status === 409 && error.code === "PAYMENT_RECONCILIATION_PENDING"
+  );
+  assert.equal(cancelCalls(), 0, "확인 중인 승인과 환불이 겹치면 안 된다");
+});
+
+test("canceled 상태에서는 카드 변경 세션을 만들지 않는다", async () => {
+  const sub = {
+    id: "sub-1", customer_id: "cust-1", status: "canceled", cancel_at_period_end: true,
+    current_period_end: "2026-12-26T00:00:00Z"
+  };
+  const cust = { id: "cust-1", email: "buyer@example.com" };
+  let queries = 0;
+  const db = {
+    async one(sql) {
+      if (/FROM subscriptions WHERE id=/.test(sql)) return { ...sub };
+      if (/FROM customers WHERE id=/.test(sql)) return { ...cust };
+      return null;
+    },
+    async q() { queries += 1; return { rows: [], rowCount: 1 }; },
+    async tx() { queries += 1; throw new Error("카드 변경 세션을 만들면 안 됨"); },
+    async withNamedLock(_name, fn) { return fn(); }
+  };
