+import test from "node:test";
+import assert from "node:assert/strict";
+import { makeToss } from "../src/toss.js";
+
+const SECRET = "test_sk_secret";
+const AUTH = "Basic " + Buffer.from(SECRET + ":").toString("base64");
+
+function response(body, status = 200, contentType = "application/json") {
+  return new Response(body == null ? "" : typeof body === "string" ? body : JSON.stringify(body), {
+    status,
+    headers: { "Content-Type": contentType }
+  });
+}
+
+function recorder(replies = []) {
+  const calls = [];
+  const fetchImpl = async (url, options) => {
+    calls.push({ url, options });
+    return replies.length ? replies.shift() : response({ ok: true });
+  };
+  return { calls, fetchImpl };
+}
+
+function client(rec, extra = {}) {
+  return makeToss({
+    TOSS_SECRET_KEY: SECRET,
+    fetchImpl: rec.fetchImpl,
+    base: "https://toss.test",
+    signalFactory: (ms) => ({ timeoutMs: ms }),
+    ...extra
+  });
+}
+
+test("승인은 메서드·인증·JSON·멱등키를 정확히 전달하고 경로를 인코딩한다", async () => {
+  const rec = recorder([response({ status: "DONE" })]);
+  const toss = client(rec);
+
+  await toss.charge({
+    billingKey: "bill/key 한글",
+    customerKey: "customer-1",
+    amount: 6000,
+    orderId: "order_1",
+    orderName: "Donna Plus",
+    customerEmail: "paid@example.com",
+    customerName: "paid"
+  });
+
+  assert.equal(rec.calls[0].url, "https://toss.test/v1/billing/bill%2Fkey%20%ED%95%9C%EA%B8%80");
+  assert.equal(rec.calls[0].options.method, "POST");
+  assert.equal(rec.calls[0].options.headers.Authorization, AUTH);
+  assert.equal(rec.calls[0].options.headers["Content-Type"], "application/json");
+  assert.equal(rec.calls[0].options.headers["Idempotency-Key"], "order_1");
+  assert.deepEqual(JSON.parse(rec.calls[0].options.body), {
+    customerKey: "customer-1", amount: 6000, orderId: "order_1", orderName: "Donna Plus",
+    customerEmail: "paid@example.com", customerName: "paid"
+  });
+  assert.deepEqual(rec.calls[0].options.signal, { timeoutMs: 60_000 });
+});
+
+test("결제키·주문번호 조회와 빌링키 삭제는 경로를 인코딩하고 body를 보내지 않는다", async () => {
+  const rec = recorder([response({}), response({}), response({})]);
+  const toss = client(rec);
+
+  await toss.getPayment("pay/key ?");
+  await toss.getPaymentByOrderId("주문/1 ?");
+  await toss.deleteBillingKey({ billingKey: "bill/key ?" });
+
+  assert.deepEqual(rec.calls.map(c => [c.options.method, c.url]), [
+    ["GET", "https://toss.test/v1/payments/pay%2Fkey%20%3F"],
+    ["GET", "https://toss.test/v1/payments/orders/%EC%A3%BC%EB%AC%B8%2F1%20%3F"],
+    ["DELETE", "https://toss.test/v1/billing/bill%2Fkey%20%3F"]
+  ]);
+  for (const { options } of rec.calls) {
+    assert.equal(options.headers.Authorization, AUTH);
+    assert.equal(options.body, undefined);
+    assert.equal("Idempotency-Key" in options.headers, false);
+  }
+});
+
+test("취소 멱등키는 호출자가 attemptKey를 명시한 시도에만 보낸다", async () => {
+  const rec = recorder([response({ status: "CANCELED" }), response({ status: "CANCELED" })]);
+  const toss = client(rec);
+
+  await toss.cancel({ paymentKey: "pay/1", cancelReason: "고객 요청", cancelAmount: 0 });
+  await toss.cancel({ paymentKey: "pay/2", cancelReason: "재시도", attemptKey: "refund_attempt_2" });
+
+  assert.equal(rec.calls[0].url, "https://toss.test/v1/payments/pay%2F1/cancel");
+  assert.deepEqual(JSON.parse(rec.calls[0].options.body), { cancelReason: "고객 요청", cancelAmount: 0 });
+  assert.equal("Idempotency-Key" in rec.calls[0].options.headers, false);
+  assert.deepEqual(JSON.parse(rec.calls[1].options.body), { cancelReason: "재시도" });
+  assert.equal(rec.calls[1].options.headers["Idempotency-Key"], "refund_attempt_2");
+});
+
+test("요청 타임아웃은 최소 60초이고 signalFactory로 주입할 수 있다", async () => {
+  const seen = [];
+  const rec = recorder([response({})]);
+  const toss = client(rec, { timeoutMs: 1, signalFactory: (ms) => { seen.push(ms); return { ms }; } });
+
+  await toss.getPayment("pay_1");
+
+  assert.deepEqual(seen, [60_000]);
+  assert.deepEqual(rec.calls[0].options.signal, { ms: 60_000 });
+});
+
+test("토스 JSON 오류의 message·code·status·body를 보존한다", async () => {
+  const body = { code: "REJECT_CARD_PAYMENT", message: "한도 초과", detail: "issuer" };
+  const rec = recorder([response(body, 400)]);
+  const toss = client(rec);
+
+  await assert.rejects(
+    () => toss.getPayment("pay_1"),
+    (err) => {
+      assert.equal(err.message, "한도 초과");
+      assert.equal(err.code, "REJECT_CARD_PAYMENT");
+      assert.equal(err.status, 400);
+      assert.deepEqual(err.body, body);
+      return true;
+    }
+  );
+});
+
+test("비 JSON 오류도 상태 코드로 안전하게 보고한다", async () => {
+  const rec = recorder([response("upstream unavailable", 503, "text/plain")]);
+  const toss = client(rec);
+
+  await assert.rejects(
+    () => toss.getPaymentByOrderId("order_1"),
+    (err) => {
+      assert.equal(err.message, "toss 503");
+      assert.equal(err.code, null);
+      assert.equal(err.status, 503);
+      assert.equal(err.body, null);
+      return true;
+    }
+  );
+});
