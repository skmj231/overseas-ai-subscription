diff --git a/server/src/manage-action-auth.js b/server/src/manage-action-auth.js
new file mode 100644
index 0000000..3178091
--- /dev/null
+++ b/server/src/manage-action-auth.js
@@ -0,0 +1,242 @@
+/*
+ * Management authorization for a passwordless billing product.
+ *
+ * - A 30-day opaque session is read-only. It can render the management page
+ *   and request a step-up email, but cannot mutate billing state.
+ * - A sensitive action needs a separate opaque token. It is short-lived,
+ *   single-use, bound to one session/action/resource and one subscription
+ *   state version, and only its SHA-256 digest is stored.
+ * - manage_auth_version revokes every existing session without enumerating
+ *   tokens. manage_state_version invalidates stale action links after a
+ *   successful state change.
+ */
+import { createHash, randomBytes } from "node:crypto";
+
+export const MANAGEMENT_ACTIONS = Object.freeze([
+  "cancel_subscription",
+  "resume_subscription",
+  "refund_payment",
+  "change_card",
+  "unlink_install"
+]);
+
+const ACTION_SET = new Set(MANAGEMENT_ACTIONS);
+const READ_SESSION_TTL_MS = 30 * 24 * 60 * 60 * 1000;
+const ACTION_TTL_MS = 10 * 60 * 1000;
+const MAX_READ_SESSION_TTL_MS = 30 * 24 * 60 * 60 * 1000;
+const MAX_ACTION_TTL_MS = 15 * 60 * 1000;
+
+function authError(message, code = "MANAGE_AUTH_REQUIRED") {
+  return Object.assign(new Error(message), { status: 401, code });
+}
+
+function conflict(message, code) {
+  return Object.assign(new Error(message), { status: 409, code });
+}
+
+function hash(raw) {
+  return createHash("sha256").update(String(raw), "utf8").digest();
+}
+
+function cleanTarget(value) {
+  if (value == null || value === "") return null;
+  const target = String(value);
+  if (target.length > 200) throw Object.assign(new Error("작업 대상 값이 너무 깁니다."), { status: 400, code: "ACTION_TARGET_INVALID" });
+  return target;
+}
+
+function validToken(raw, prefix) {
+  return typeof raw === "string" && raw.startsWith(prefix + ".") && /^[A-Za-z0-9_-]{43}$/.test(raw.slice(prefix.length + 1));
+}
+
+function opaque(prefix, entropy) {
+  return `${prefix}.${entropy(32).toString("base64url")}`;
+}
+
+function asMillis(value) {
+  return value instanceof Date ? value.getTime() : new Date(value).getTime();
+}
+
+export function makeManageActionAuth({ db, now = () => new Date(), entropy = randomBytes }) {
+  function assertAction(action) {
+    if (!ACTION_SET.has(action)) {
+      throw Object.assign(new Error("허용되지 않은 관리 작업입니다."), { status: 400, code: "ACTION_NOT_ALLOWED" });
+    }
+  }
+
+  function assertSessionRow(row) {
+    const at = now().getTime();
+    if (!row || row.session_revoked_at || asMillis(row.session_expires_at) <= at ||
+        Number(row.session_auth_version) !== Number(row.subscription_auth_version)) {
+      throw authError("관리 세션이 만료됐거나 폐기됐습니다. 결제 이메일에서 관리 링크를 다시 열어 주세요.", "MANAGE_SESSION_INVALID");
+    }
+  }
+
+  async function issueReadSession(subscriptionId, { ttlMs = READ_SESSION_TTL_MS } = {}) {
+    const ttl = Math.min(Number(ttlMs) || READ_SESSION_TTL_MS, MAX_READ_SESSION_TTL_MS);
+    if (ttl <= 0) throw Object.assign(new Error("관리 세션 유효시간이 올바르지 않습니다."), { status: 400 });
+    const raw = opaque("ms1", entropy);
+    const expiresAt = new Date(now().getTime() + ttl);
+    const row = await db.tx(async c => {
+      const sub = (await c.query("SELECT id, manage_auth_version FROM subscriptions WHERE id=$1 FOR UPDATE", [subscriptionId])).rows[0];
+      if (!sub) throw Object.assign(new Error("구독이 없습니다."), { status: 404 });
+      return (await c.query(`INSERT INTO management_sessions(subscription_id, token_hash, auth_version, expires_at)
+                            VALUES($1,$2,$3,$4) RETURNING id, expires_at`,
+                            [sub.id, hash(raw), sub.manage_auth_version, expiresAt])).rows[0];
+    });
+    return { session_token: raw, session_id: row.id, expires_at: row.expires_at };
+  }
+
+  async function authenticateRead(sessionToken, { touch = true } = {}) {
+    if (!validToken(sessionToken, "ms1")) throw authError("관리 세션이 올바르지 않습니다.", "MANAGE_SESSION_INVALID");
+    const row = await db.one(`SELECT ms.id AS session_id, ms.subscription_id,
+                                    ms.auth_version AS session_auth_version,
+                                    ms.expires_at AS session_expires_at,
+                                    ms.revoked_at AS session_revoked_at,
+                                    s.customer_id,
+                                    s.manage_auth_version AS subscription_auth_version,
+                                    s.manage_state_version AS subscription_state_version
+                               FROM management_sessions ms
+                               JOIN subscriptions s ON s.id=ms.subscription_id
+                              WHERE ms.token_hash=$1`, [hash(sessionToken)]);
+    assertSessionRow(row);
+    if (touch) await db.q("UPDATE management_sessions SET last_seen_at=now() WHERE id=$1", [row.session_id]);
+    return {
+      sessionId: row.session_id,
+      subscriptionId: row.subscription_id,
+      customerId: row.customer_id,
+      authVersion: Number(row.subscription_auth_version),
+      stateVersion: Number(row.subscription_state_version)
+    };
+  }
+
+  async function issueAction(sessionToken, { action, targetKey = null, ttlMs = ACTION_TTL_MS } = {}) {
+    assertAction(action);
+    if (!validToken(sessionToken, "ms1")) throw authError("관리 세션이 올바르지 않습니다.", "MANAGE_SESSION_INVALID");
+    const target = cleanTarget(targetKey);
+    const ttl = Math.min(Number(ttlMs) || ACTION_TTL_MS, MAX_ACTION_TTL_MS);
+    if (ttl <= 0) throw Object.assign(new Error("작업 확인 링크의 유효시간이 올바르지 않습니다."), { status: 400 });
+    const raw = opaque("ma1", entropy);
+    const expiresAt = new Date(now().getTime() + ttl);
+    const made = await db.tx(async c => {
+      const session = (await c.query(`SELECT ms.id AS session_id, ms.subscription_id,
+                                            ms.auth_version AS session_auth_version,
+                                            ms.expires_at AS session_expires_at,
+                                            ms.revoked_at AS session_revoked_at,
+                                            s.manage_auth_version AS subscription_auth_version,
+                                            s.manage_state_version AS subscription_state_version
+                                       FROM management_sessions ms
+                                       JOIN subscriptions s ON s.id=ms.subscription_id
+                                      WHERE ms.token_hash=$1
+                                      FOR UPDATE OF ms, s`, [hash(sessionToken)])).rows[0];
+      assertSessionRow(session);
+      // Only one sensitive action may be pending for a subscription.  A newer
+      // request revokes older links from every browser/session so two emails
+      // cannot race into different billing mutations.
+      await c.query(`UPDATE management_action_tokens
+                        SET revoked_at=now()
+                      WHERE subscription_id=$1
+                        AND used_at IS NULL AND revoked_at IS NULL`,
+                    [session.subscription_id]);
+      return (await c.query(`INSERT INTO management_action_tokens(
+                              management_session_id, subscription_id, action, target_key,
+                              token_hash, auth_version, state_version, expires_at)
+                            VALUES($1,$2,$3,$4,$5,$6,$7,$8)
+                            RETURNING id, expires_at`,
+                           [session.session_id, session.subscription_id, action, target, hash(raw),
+                            session.subscription_auth_version, session.subscription_state_version, expiresAt])).rows[0];
+    });
+    return { action_token: raw, action_id: made.id, expires_at: made.expires_at };
+  }
+
+  /*
+   * Call this inside the same per-subscription advisory lock used by the
+   * business mutation. Marking the token used happens before side effects:
+   * a retry must request a fresh action link, while provider calls retain
+   * their own stable idempotency key.
+   */
+  async function consumeAction(sessionToken, actionToken, { action, targetKey = null, expectedSubscriptionId = null } = {}) {
+    assertAction(action);
+    if (!validToken(sessionToken, "ms1") || !validToken(actionToken, "ma1")) {
+      throw authError("작업 확인 링크가 올바르지 않습니다.", "ACTION_TOKEN_INVALID");
+    }
+    const target = cleanTarget(targetKey);
+    return db.tx(async c => {
+      const row = (await c.query(`SELECT a.id AS action_id, a.action, a.target_key,
+                                        a.auth_version AS action_auth_version,
+                                        a.state_version AS action_state_version,
+                                        a.expires_at AS action_expires_at,
+                                        a.used_at AS action_used_at,
+                                        a.revoked_at AS action_revoked_at,
+                                        ms.id AS session_id, ms.subscription_id,
+                                        ms.auth_version AS session_auth_version,
+                                        ms.expires_at AS session_expires_at,
+                                        ms.revoked_at AS session_revoked_at,
+                                        s.customer_id,
+                                        s.manage_auth_version AS subscription_auth_version,
+                                        s.manage_state_version AS subscription_state_version
+                                   FROM management_action_tokens a
+                                   JOIN management_sessions ms ON ms.id=a.management_session_id
+                                                                  AND ms.subscription_id=a.subscription_id
+                                   JOIN subscriptions s ON s.id=a.subscription_id
+                                  WHERE a.token_hash=$1 AND ms.token_hash=$2
+                                  FOR UPDATE OF a, ms, s`, [hash(actionToken), hash(sessionToken)])).rows[0];
+      assertSessionRow(row);
+      const at = now().getTime();
+      if (!row || row.action_revoked_at || asMillis(row.action_expires_at) <= at) {
+        throw authError("작업 확인 링크가 만료됐거나 폐기됐습니다. 새 확인 메일을 요청해 주세요.", "ACTION_TOKEN_INVALID");
+      }
+      if (row.action_used_at) throw conflict("이미 사용한 작업 확인 링크입니다. 같은 작업이 처리됐는지 먼저 확인해 주세요.", "ACTION_TOKEN_USED");
+      if (row.action !== action || (row.target_key || null) !== target) {
+        throw authError("이 확인 링크는 요청한 작업이나 대상과 일치하지 않습니다.", "ACTION_TOKEN_SCOPE_MISMATCH");
+      }
+      if (expectedSubscriptionId && row.subscription_id !== expectedSubscriptionId) {
+        throw authError("이 확인 링크는 다른 이용권에 발급됐습니다.", "ACTION_TOKEN_SCOPE_MISMATCH");
+      }
+      if (Number(row.action_auth_version) !== Number(row.subscription_auth_version) ||
+          Number(row.action_state_version) !== Number(row.subscription_state_version)) {
+        throw conflict("확인 링크를 받은 뒤 이용권 상태가 바뀌었습니다. 현재 상태를 확인하고 새 링크를 요청해 주세요.", "ACTION_STATE_CHANGED");
+      }
+      const used = await c.query("UPDATE management_action_tokens SET used_at=now() WHERE id=$1 AND used_at IS NULL RETURNING id", [row.action_id]);
+      if (!used.rowCount && !used.rows[0]) throw conflict("이미 사용한 작업 확인 링크입니다.", "ACTION_TOKEN_USED");
+      return {
+        actionId: row.action_id,
+        sessionId: row.session_id,
+        subscriptionId: row.subscription_id,
+        customerId: row.customer_id,
+        stateVersion: Number(row.subscription_state_version)
+      };
+    });
+  }
+
+  async function bumpState(subscriptionId, expectedStateVersion) {
+    const row = await db.one(`UPDATE subscriptions
+                                 SET manage_state_version=manage_state_version+1, updated_at=now()
+                               WHERE id=$1 AND manage_state_version=$2
+                               RETURNING manage_state_version`, [subscriptionId, expectedStateVersion]);
+    if (!row) throw conflict("이용권 상태가 동시에 변경됐습니다. 현재 상태를 다시 불러와 주세요.", "ACTION_STATE_CHANGED");
+    return { stateVersion: Number(row.manage_state_version) };
+  }
+
+  async function revokeSession(sessionToken) {
+    if (!validToken(sessionToken, "ms1")) return { ok: true, revoked: false };
+    const r = await db.q("UPDATE management_sessions SET revoked_at=COALESCE(revoked_at,now()) WHERE token_hash=$1 AND revoked_at IS NULL", [hash(sessionToken)]);
+    return { ok: true, revoked: Number(r.rowCount || 0) > 0 };
+  }
+
+  async function revokeAll(subscriptionId) {
+    return db.tx(async c => {
+      const sub = (await c.query(`UPDATE subscriptions
+                                     SET manage_auth_version=manage_auth_version+1,
+                                         manage_state_version=manage_state_version+1,
+                                         updated_at=now()
+                                   WHERE id=$1
+                                   RETURNING manage_auth_version, manage_state_version`, [subscriptionId])).rows[0];
+      if (!sub) throw Object.assign(new Error("구독이 없습니다."), { status: 404 });
+      await c.query("UPDATE management_sessions SET revoked_at=COALESCE(revoked_at,now()) WHERE subscription_id=$1 AND revoked_at IS NULL", [subscriptionId]);
+      return { ok: true, authVersion: Number(sub.manage_auth_version), stateVersion: Number(sub.manage_state_version) };
+    });
+  }
+
+  return { issueReadSession, authenticateRead, issueAction, consumeAction, bumpState, revokeSession, revokeAll };
+}
